# GEMINI_API_KEY: Necessário para as funções pedagógicas com IA do Gemini.
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# SUPABASE: Opcional para persistência remota no PostgreSQL do Supabase.
# Caso não configurado, o Aura utiliza o armazenamento local seguro (localStorage) com dados de demonstração.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-public-do-supabase"

# APP_URL: URL onde a aplicação está hospedada.
APP_URL="https://sua-aplicacao.vercel.app"
